    "astro": "^6.4.8",
    "astro-icon": "^1.1.5",
    "astro-loading-indicator": "^0.8.0",
    "astro-mermaid": "^2.0.4",
    "astro-pagefind": "^2.0.0",
    "astro-robots-txt": "^1.0.0",
    "astro-seo": "^1.1.0",
    "astro-tooltips": "^0.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
