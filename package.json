    "@lint-md/cli": "^2.0.0",
    "@rollup/plugin-yaml": "^5.0.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/hast": "^3.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.0.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/three": "^0.184.1",
    "@types/unist": "^3.0.3",
    "@xsai/generate-text": "0.5.0-beta.6",
    "chalk": "^5.6.2",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "ink": "^7.1.0",
    "knip": "^6.17.1",
    "lint-staged": "^17.0.7",
    "remark": "^15.0.1",
    "sharp": "^0.35.2",
    "shiki": "^4.2.0",
    "sonda": "^0.13.1",
    "strip-markdown": "^6.0.0",
    "transliteration": "^2.6.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-svgr": "^5.2.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,astro}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{md,mdx}": [
      "lint-md --fix"
    ]
  }
}